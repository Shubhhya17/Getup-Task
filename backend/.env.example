PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://root:rootpassword@localhost:27017/supportdb?authSource=admin

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# AI Provider: "openai" | "anthropic" | "mock"
AI_PROVIDER=openai
# Leave blank to use mock fallback automatically
AI_API_KEY=

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# CORS
FRONTEND_URL=http://localhost:3000
